# Postgres from compose.yaml. On Railway the reference ${{postgres.DATABASE_URL}}.
DATABASE_URL=postgres://piano:piano@localhost:5432/piano
# Origin the browser uses, production only: https://piano.shubrt.me. Leave it
# unset locally, the login then works on every portless worktree URL.
PUBLIC_URL=
# Signs the session cookie, at least 32 random bytes: openssl rand -base64 32
SESSION_SECRET=
# Python worker for YouTube and audio imports. Leave it unset locally, vp run
# dev:worker registers the worker with portless and the app asks portless.
WORKER_URL=
# Shared secret between web and worker, any long random string.
WORKER_TOKEN=
# OpenRouter key for the "KI-Analyse" button and benchmark references. New songs
# get their structure from the local heuristic, so the key is optional.
OPENROUTER_API_KEY=
# Model behind the "KI-Analyse" button. Opus found the part boundaries of both
# test songs, Sonnet missed the two-bar transition in Ancient Stones every time.
STRUCTURE_MODEL=anthropic/claude-opus-5
