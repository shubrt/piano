# OpenRouter key for the "KI-Analyse" button and benchmark references. New songs
# get their structure from the local heuristic, so the key is optional.
OPENROUTER_API_KEY=
# Model behind the "KI-Analyse" button. Opus found the part boundaries of both
# test songs, Sonnet missed the two-bar transition in Ancient Stones every time.
STRUCTURE_MODEL=anthropic/claude-opus-5
